{
  "name": "SIVEA · Sistema Inteligente de Verificación Ambiental",
  "short_name": "SIVEA",
  "description": "Revisión de informes semestrales de seguimiento ambiental y generación de la lista de verificación. Los informes se leen en el equipo y no se envían a ningún lado.",
  "id": "/SIVEA/",
  "lang": "es",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "launch_handler": { "client_mode": "focus-existing" },
  "orientation": "any",
  "background_color": "#eef2f6",
  "theme_color": "#0b2140",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
